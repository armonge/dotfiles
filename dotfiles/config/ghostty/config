# General
theme = TokyoNight Storm
command = /opt/homebrew/bin/bash -l

# Font
font-family = JetBrains Mono
font-size = 12

# Cursor
cursor-style = block
cursor-style-blink = true

# Window
window-padding-x = 0
window-padding-y = 10,7
background-opacity = 0.96
confirm-close-surface = false
unfocused-split-opacity = 1

# Tab bar
window-show-tab-bar = always

# Scrollback
scrollback-limit = 10000000

# Keybindings ported from WezTerm config

# Misc
keybind = shift+enter=text:\x1b\r
keybind = f11=toggle_fullscreen

# Copy/Paste
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Tabs
keybind = super+t=new_tab
keybind = super+left_bracket=previous_tab
keybind = super+right_bracket=next_tab
keybind = super+one=goto_tab:1
keybind = super+two=goto_tab:2
keybind = super+three=goto_tab:3
keybind = super+four=goto_tab:4
keybind = super+five=goto_tab:5
keybind = super+six=goto_tab:6
keybind = super+seven=goto_tab:7
keybind = super+eight=goto_tab:8

# Panes/Splits
keybind = super+backslash=new_split:right
keybind = super+ctrl+backslash=new_split:down
keybind = super+enter=toggle_split_zoom
keybind = super+w=close_surface
keybind = super+ctrl+k=goto_split:top
keybind = super+ctrl+j=goto_split:bottom
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+l=goto_split:right

# Scrolling
keybind = page_up=scroll_page_up
keybind = page_down=scroll_page_down

# Windows
keybind = super+n=new_window
